PORT=3000
# Rodando a API fora do Docker: banco do compose na porta 5433 de localhost.
# Dentro do docker compose este valor é substituído automaticamente.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/localmenu?schema=public
POSTGRES_PASSWORD=postgres
# Gere valores longos e aleatórios para os dois segredos, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Serviço de OCR (localmenu_OCRservice)
AI_SERVICE_URL=http://localhost:8000
# Origens que podem chamar a API pelo navegador (apps Expo Web), separadas por vírgula
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
